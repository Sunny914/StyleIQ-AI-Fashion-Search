  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# ProductIQ Phase 4 — Step 4.11: Embedding Generation\n",
        "\n",
        "Demonstrates local BGE encoding over `semantic_text`. Production batch jobs use `scripts/run_product_embedding_generation.py`."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from pathlib import Path\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "from productiq.retrieval.embedding_encoder import create_bge_small_en_v15_encoder, format_bge_query_text\n",
        "from productiq.retrieval.embedding_builder import validate_embedding_vectors\n",
        "from productiq.retrieval.embedding_schema import REPRESENTATION_PARQUET_FILENAME\n",
        "\n",
        "ROOT = Path.cwd().parents[1] if Path.cwd().name == \"data_engineering\" else Path.cwd()\n",
        "source = ROOT / \"resources\" / \"processed\" / REPRESENTATION_PARQUET_FILENAME\n",
        "sample = pd.read_parquet(source, columns=[\"product_id\", \"semantic_text\"]).head(500)\n",
        "encoder = create_bge_small_en_v15_encoder(device=\"cpu\")\n",
        "print(\"Model:\", encoder.model_id)\n",
        "print(\"Revision:\", encoder.model_revision)\n",
        "print(\"Device:\", encoder.device)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "docs = encoder.encode_documents(sample[\"semantic_text\"].astype(str).tolist())\n",
        "validate_embedding_vectors(docs, expected_dimension=encoder.embedding_dimension)\n",
        "norms = np.linalg.norm(docs, axis=1)\n",
        "print(\"Shape:\", docs.shape)\n",
        "print(\"Norm mean:\", float(norms.mean()), \"std:\", float(norms.std()))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import time\n",
        "\n",
        "query = encoder.encode_query(\"blue denim jacket\")\n",
        "print(\"Query dim:\", len(query.values))\n",
        "print(\"Query prefix example:\", format_bge_query_text(\"blue denim jacket\")[:80], \"...\")\n",
        "\n",
        "texts = sample[\"semantic_text\"].astype(str).tolist()\n",
        "started = time.perf_counter()\n",
        "_ = encoder.encode_documents(texts)\n",
        elapsed = time.perf_counter() - started\n",
        "print(f\"Pilot sample throughput: {len(texts) / elapsed:.2f} docs/sec over {len(texts)} products\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Full catalog\n",
        "\n",
        "Run from repo root:\n",
        "\n",
        "```bash\n",
        "python scripts/run_product_embedding_generation.py --max-products 1000 --pin-selection-revision\n",
        "python scripts/run_product_embedding_generation.py --device cpu --batch-size 64 --pin-selection-revision\n",
        "```"
      ]
    }
  ],
