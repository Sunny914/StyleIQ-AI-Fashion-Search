# Local development configuration template.
# Copy this file to .env and adjust values for your machine.
# Do not commit .env or put real secrets in this file.

APP_NAME=ProductIQ
APP_ENV=development
LOG_LEVEL=INFO

# Database (use one style)
DATABASE_URL=postgresql://productiq:productiq@localhost:5432/productiq
# Or component fields (requires PRODUCTIQ_DATABASE_USE_COMPONENT_FIELDS=1):
# PRODUCTIQ_DATABASE_USE_COMPONENT_FIELDS=0
# PRODUCTIQ_DATABASE_HOST=localhost
# PRODUCTIQ_DATABASE_PORT=5432
# PRODUCTIQ_DATABASE_NAME=productiq
# PRODUCTIQ_DATABASE_USER=productiq
DATABASE_PASSWORD=

# Artifact paths (relative to project root or deployment mount)
# PRODUCTIQ_PROCESSED_CATALOG_PATH=resources/processed/product_catalog.parquet
# PRODUCTIQ_BM25_ARTIFACT_PATH=resources/processed/bm25
# PRODUCTIQ_EMBEDDINGS_ARTIFACT_PATH=resources/processed/product_embeddings.parquet
# PRODUCTIQ_MODEL_ARTIFACTS_DIR=resources/models

# CORS (comma-separated). Development defaults to local Next.js if unset.
# PRODUCTIQ_CORS_ALLOWED_ORIGINS=http://localhost:3000
# PRODUCTIQ_CORS_ALLOW_CREDENTIALS=0

# HTTP serving (Phase 13 — see docs/architecture/deployment-configuration.md)
# PRODUCTIQ_SERVICE_NAME=productiq
# PRODUCTIQ_API_VERSION=v1
# PRODUCTIQ_RATE_LIMIT_ENABLED=0
