# Local development configuration template.
# Copy this file to .env and adjust values for your machine.
# Do not commit .env or put real secrets in this file.

APP_NAME=ProductIQ
APP_ENV=development
LOG_LEVEL=INFO

# Database (use one style)
DATABASE_URL=postgresql://productiq:productiq@localhost:5432/productiq

# Docker Compose (Phase 15B) — copy to .env; hostname MUST be `postgres` inside Compose
# POSTGRES_DB=productiq
# POSTGRES_USER=productiq
# POSTGRES_PASSWORD=replace-with-local-dev-password
# DATABASE_URL=postgresql+psycopg://productiq:replace-with-local-dev-password@postgres:5432/productiq
# PRODUCTIQ_API_PORT=8000
# Phase 15C serving (Compose). Default API does not load 367k rows at startup.
# PRODUCTIQ_ENABLE_PRODUCTION_SERVING=1
# PRODUCTIQ_CATALOG_LOAD_MODE=fixture
# PRODUCTIQ_ARTIFACTS_HOST=./resources/processed
# PRODUCTIQ_PROCESSED_CATALOG_PATH=/artifacts/processed/product_catalog.parquet
# PRODUCTIQ_BM25_ARTIFACT_PATH=/artifacts/processed/bm25_lexical_index.pkl
# PRODUCTIQ_EMBEDDINGS_ARTIFACT_PATH=/artifacts/processed/product_embeddings.parquet
# Or component fields (requires PRODUCTIQ_DATABASE_USE_COMPONENT_FIELDS=1):
# PRODUCTIQ_DATABASE_USE_COMPONENT_FIELDS=0
# PRODUCTIQ_DATABASE_HOST=localhost
# PRODUCTIQ_DATABASE_PORT=5432
# PRODUCTIQ_DATABASE_NAME=productiq
# PRODUCTIQ_DATABASE_USER=productiq
DATABASE_PASSWORD=

# Artifact paths (relative to project root or deployment mount)
# PRODUCTIQ_PROCESSED_CATALOG_PATH=resources/processed/product_catalog.parquet
# PRODUCTIQ_BM25_ARTIFACT_PATH=resources/processed/bm25
# PRODUCTIQ_EMBEDDINGS_ARTIFACT_PATH=resources/processed/product_embeddings.parquet
# PRODUCTIQ_MODEL_ARTIFACTS_DIR=resources/models

# CORS (comma-separated). APP_ENV=development defaults to http://localhost:3000 and
# http://127.0.0.1:3000 when this is unset. Production leaves origins empty.
# Do not combine a wildcard origin with PRODUCTIQ_CORS_ALLOW_CREDENTIALS=1.
# PRODUCTIQ_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# PRODUCTIQ_CORS_ALLOW_CREDENTIALS=0

# HTTP serving (Phase 13 — see docs/architecture/deployment-configuration.md)
# PRODUCTIQ_SERVICE_NAME=productiq
# PRODUCTIQ_API_VERSION=v1
# PRODUCTIQ_RATE_LIMIT_ENABLED=0
